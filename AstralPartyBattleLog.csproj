<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AstralPartyBattleLog</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.3.1</Version>

    <!-- 본인 게임의 BepInEx 폴더 위치에 맞게 수정 -->
    <BepInExDir>D:\SteamLibrary\steamapps\common\Astral Party\8vJXnINT\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 코어 / IL2CPP 런타임 -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExDir)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Il2CppStructArray 등 IL2CPP 객체 기반 타입 -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInExDir)\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Il2CppSystem.Net.Sockets.Socket — 후킹 대상이 여기 있음 -->
    <Reference Include="Il2CppSystem">
      <HintPath>$(BepInExDir)\interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 인게임 오버레이 (uGUI Canvas / Image / Text) -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BepInExDir)\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Font, TextAnchor 등 -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Addressables — 게임이 놓아버린 설정 에셋을 우리가 직접 불러오는 데 쓴다.
         BepInEx 플러그인은 프레임 2500쯤에야 올라오는데 게임은 그 전에 설정을
         로드하고 곧바로 Release한다. 주워 담는 걸로는 절대 못 잡는다 (실측). -->
    <Reference Include="Unity.Addressables">
      <HintPath>$(BepInExDir)\interop\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(BepInExDir)\interop\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Input.GetKeyDown (토글 키) -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
